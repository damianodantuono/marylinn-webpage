---
import { getStudio, getWhatsAppUrl } from "@/lib/content";

const site = await getStudio();

type Props = {
  title?: string;
  description?: string;
  buttonLabel?: string;
  message?: string;
};

const {
  title = site.conversion.title,
  description = site.conversion.description,
  buttonLabel = site.conversion.buttonLabel,
  message,
} = Astro.props;
const bookingUrl = getWhatsAppUrl(site, message);
---

<section class="mx-auto max-w-7xl px-5 py-16 sm:px-8 sm:py-24" aria-labelledby="conversion-title">
  <div class="grid overflow-hidden rounded-[2rem] bg-[#F2ECE4] md:grid-cols-[1.2fr_0.8fr]">
    <div class="px-7 py-10 sm:px-12 sm:py-14">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[#8A684A]">Parliamone insieme</p>
      <h2 id="conversion-title" class="mt-4 max-w-xl font-display text-4xl leading-tight sm:text-5xl">
        {title}
      </h2>
      {description?.trim() && (
        <p class="mt-5 max-w-xl text-sm leading-7 text-[#625850]">{description}</p>
      )}
      <a
        class="mt-8 inline-flex rounded-full bg-[#1F1D1B] px-7 py-4 text-sm font-semibold text-white transition-colors hover:bg-[#55463A]"
        href={bookingUrl ?? "/contatti"}
        target={bookingUrl ? "_blank" : undefined}
        rel={bookingUrl ? "noreferrer" : undefined}
      >
        {buttonLabel}
      </a>
    </div>

    <div class="flex flex-col justify-center border-t border-[#1F1D1B]/10 bg-[#E9DFD3] px-7 py-10 sm:px-12 md:border-l md:border-t-0">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[#8A684A]">Seguimi su Instagram</p>
      <h3 class="mt-4 font-display text-3xl">{site.conversion.instagramTitle}</h3>
      {site.conversion.instagramDescription?.trim() && (
        <p class="mt-3 text-sm leading-7 text-[#625850]">{site.conversion.instagramDescription}</p>
      )}
      {site.social.instagramUrl ? (
        <a
          class="mt-6 inline-flex w-fit items-center gap-2 text-sm font-semibold text-[#1F1D1B] underline decoration-[#B89778] underline-offset-4"
          href={site.social.instagramUrl}
          target="_blank"
          rel="noreferrer"
        >
          {site.social.instagramHandle || "Visita il profilo"}
          <span aria-hidden="true">↗</span>
        </a>
      ) : (
        <p class="mt-6 text-sm text-[#76695F]">Profilo Instagram da collegare.</p>
      )}
    </div>
  </div>
</section>
