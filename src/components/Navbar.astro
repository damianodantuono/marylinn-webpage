---
import { getStudio, getTreatments } from "@/lib/content";

const site = await getStudio();
const treatments = await getTreatments();
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const isHome = currentPath === "/";
const isCurrent = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath === href || currentPath.startsWith(`${href}/`);
---

<header
  class:list={[
    "z-40 w-full border-b transition-[background-color,border-color,color,backdrop-filter] duration-500",
    isHome
      ? "absolute inset-x-0 top-0 border-transparent bg-transparent text-white"
      : "sticky top-0 border-[#AF5A72]/15 bg-[#EFE9E8]/90 text-[#292F3F] backdrop-blur-xl",
  ]}
  data-home-header={isHome ? "true" : undefined}
>
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-5 py-3 sm:px-8 lg:py-4">
    <a class="shrink-0 rounded-full focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#AF5A72]" href="/" aria-label={`${site.brand.displayName}, home`}>
      <img
        class:list={["w-28 sm:w-32", !isHome && "hidden"]}
        src="/images/brand/logo-light.png"
        alt={site.brand.displayName}
        data-logo-light
      />
      <img
        class:list={["w-28 sm:w-32", isHome && "hidden"]}
        src="/images/brand/logo-dark.png"
        alt=""
        aria-hidden="true"
        data-logo-dark
      />
    </a>

    <nav
      class="navigation-pill hidden items-center gap-1 rounded-full border border-white/20 bg-white/10 p-1.5 backdrop-blur-xl lg:flex"
      aria-label="Navigazione principale"
    >
      {site.navigation.filter((item) => item.href !== "/trattamenti").map((item) => (
        <a
          class:list={[
            "rounded-full px-3.5 py-2 text-[0.78rem] font-medium transition-colors duration-200 hover:bg-white/15 hover:text-[#AF5A72] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#AF5A72]",
            isCurrent(item.href)
              ? "bg-white/15 text-[#AF5A72]"
              : "text-current",
          ]}
          href={item.href}
          aria-current={isCurrent(item.href) ? "page" : undefined}
        >
          {item.label.trim()}
        </a>
      ))}
      <details class="treatment-menu group relative">
        <summary
          class:list={[
            "flex cursor-pointer list-none items-center gap-1.5 rounded-full px-3.5 py-2 text-[0.78rem] font-medium transition-colors duration-200 hover:bg-white/15 hover:text-[#AF5A72] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#AF5A72]",
            currentPath.startsWith("/trattamenti") ? "bg-white/15 text-[#AF5A72]" : "text-current",
          ]}
        >
          Trattamenti
          <svg class="h-3.5 w-3.5 transition-transform group-open:rotate-180" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="m4 6 4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </summary>
        <div class="absolute right-0 top-full z-50 mt-3 min-w-60 rounded-2xl border border-[#292F3F]/[0.08] bg-white/95 p-2 text-[#292F3F] shadow-[0_20px_60px_-20px_rgba(41,47,63,0.28)] backdrop-blur-xl">
          <p class="px-3 pb-1 pt-2 text-[0.65rem] font-semibold uppercase tracking-[0.18em] text-[#AF5A72]">
            I nostri trattamenti
          </p>
          {treatments.map((service) => (
            <a
              class:list={[
                "flex items-center justify-between rounded-xl px-3 py-2.5 text-sm transition-colors hover:bg-[#EFE9E8] hover:text-[#AF5A72]",
                isCurrent(`/trattamenti/${service.slug}`) ? "bg-[#EFE9E8] text-[#AF5A72]" : "text-[#49273C]",
              ]}
              href={`/trattamenti/${service.slug}`}
              aria-current={currentPath === `/trattamenti/${service.slug}` ? "page" : undefined}
            >
              {service.navLabel?.trim() || service.name}
              <span aria-hidden="true" class="text-[#AF5A72]/60">↗</span>
            </a>
          ))}
        </div>
      </details>
    </nav>

    <a
      class="hidden shrink-0 items-center gap-2 rounded-full bg-[#AF5A72] px-5 py-3 text-xs font-semibold tracking-wide text-white shadow-[0_8px_24px_rgba(175,90,114,0.2)] transition-all hover:-translate-y-0.5 hover:bg-[#49273C] hover:shadow-[0_12px_28px_rgba(73,39,60,0.22)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#AF5A72] lg:inline-flex"
      href="/contatti"
    >
      Prenota una consulenza
      <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M3 8h10m-4-4 4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>

    <details class="mobile-menu relative lg:hidden">
      <summary class="flex cursor-pointer list-none items-center gap-2 rounded-full border border-current/20 bg-white/10 px-4 py-2.5 text-sm font-medium backdrop-blur-xl transition-colors hover:bg-white/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#AF5A72]">
        <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M3 5.5h14M3 10h14M3 14.5h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        </svg>
        Menu
      </summary>
      <nav
        class="absolute right-0 top-full z-50 mt-3 flex max-h-[min(75vh,34rem)] min-w-[min(19rem,calc(100vw-2.5rem))] flex-col overflow-y-auto rounded-3xl border border-[#292F3F]/[0.08] bg-white/95 p-3 text-[#292F3F] shadow-[0_24px_70px_-24px_rgba(41,47,63,0.35)] backdrop-blur-xl"
        aria-label="Navigazione mobile"
      >
        {site.navigation.map((item) => (
          <a
            class:list={[
              "rounded-2xl px-4 py-3 text-sm font-medium transition-colors hover:bg-[#EFE9E8]",
              isCurrent(item.href) ? "bg-[#EFE9E8] text-[#AF5A72]" : "text-[#49273C]",
            ]}
            href={item.href}
            aria-current={isCurrent(item.href) ? "page" : undefined}
          >
            {item.label.trim()}
          </a>
        ))}
        <div class="mx-3 my-2 border-t border-[#292F3F]/10"></div>
        <p class="px-4 pb-1 text-[0.65rem] font-semibold uppercase tracking-[0.18em] text-[#AF5A72]">
          Trattamenti
        </p>
        {treatments.map((service) => (
          <a
            class:list={[
              "rounded-2xl px-4 py-2.5 text-sm transition-colors hover:bg-[#EFE9E8]",
              isCurrent(`/trattamenti/${service.slug}`) ? "text-[#AF5A72]" : "text-[#49273C]/75",
            ]}
            href={`/trattamenti/${service.slug}`}
            aria-current={currentPath === `/trattamenti/${service.slug}` ? "page" : undefined}
          >
            {service.navLabel?.trim() || service.name}
          </a>
        ))}
        <a
          class="mt-2 flex items-center justify-center gap-2 rounded-2xl bg-[#AF5A72] px-4 py-3 text-sm font-semibold text-white transition-colors hover:bg-[#49273C]"
          href="/contatti"
        >
          Prenota una consulenza
          <span aria-hidden="true">→</span>
        </a>
      </nav>
    </details>
  </div>
</header>

<style>
  [data-home-header][data-scrolled="true"] .navigation-pill {
    border-color: rgb(41 47 63 / 8%);
    background-color: rgb(255 255 255 / 62%);
  }
</style>

<script>
  const homeHeader = document.querySelector<HTMLElement>("[data-home-header]");

  if (homeHeader) {
    const updateHeader = () => {
      homeHeader.dataset.scrolled = String(window.scrollY > 24);
    };

    updateHeader();
    window.addEventListener("scroll", updateHeader, { passive: true });
  }
</script>
