---
import { getStudio, getWhatsAppUrl } from "@/lib/content";

type Props = {
  message?: string;
};

const { message } = Astro.props;
const site = await getStudio();
const whatsappUrl = getWhatsAppUrl(site, message);
---

{whatsappUrl && (
  <a
    class="fixed bottom-5 right-5 z-50 inline-flex min-h-14 items-center gap-3 rounded-full bg-[#285C45] px-5 py-3 text-sm font-semibold text-white shadow-lg transition-transform hover:scale-[1.03] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#285C45]"
    href={whatsappUrl}
    target="_blank"
    rel="noreferrer"
    aria-label="Scrivi a MAR STUDIO su WhatsApp"
  >
    <svg aria-hidden="true" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
      <path d="M12.04 2a9.9 9.9 0 0 0-8.47 15.03L2 22l5.1-1.53A9.9 9.9 0 1 0 12.04 2Zm0 18.02a8.1 8.1 0 0 1-4.13-1.13l-.3-.18-3.03.91.93-2.95-.2-.31a8.1 8.1 0 1 1 6.73 3.66Zm4.45-6.07c-.24-.12-1.42-.7-1.64-.78-.22-.08-.38-.12-.54.12-.16.24-.62.78-.76.94-.14.16-.28.18-.52.06-.24-.12-1.02-.38-1.94-1.2-.72-.64-1.2-1.43-1.34-1.67-.14-.24-.02-.37.1-.49.1-.1.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.54-1.3-.74-1.78-.2-.47-.4-.4-.54-.4l-.46-.01c-.16 0-.42.06-.64.3-.22.24-.84.82-.84 2s.86 2.32.98 2.48c.12.16 1.7 2.6 4.12 3.64.58.25 1.03.4 1.38.51.58.18 1.1.15 1.51.09.46-.07 1.42-.58 1.62-1.14.2-.56.2-1.04.14-1.14-.06-.1-.22-.16-.46-.28Z" />
    </svg>
    <span>WhatsApp</span>
  </a>
)}
