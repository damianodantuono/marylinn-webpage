---
import AnimatedStats from "@/components/AnimatedStats.astro";
import CtaConversionBlock from "@/components/CtaConversionBlock.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getReviews, getStudio, getTreatments } from "@/lib/content";

const site = await getStudio();
const treatments = await getTreatments();
const reviews = await getReviews();
const heroVideo = site.hero.heroVideo?.trim();
const heroPoster = site.hero.heroPoster?.trim() || site.hero.image?.trim() || site.media.studioVideo.poster;
const heroTitleWords = site.hero.title.trim().split(/\s+/);
const heroTitleEmphasis = heroTitleWords.pop() ?? "";
const heroTitleLead = heroTitleWords.join(" ");
---

<BaseLayout
  title="Bellezza e dermopigmentazione"
  description={site.brand.description?.trim() || undefined}
  whatsappMessage="Ciao Marylin, vorrei prenotare una consulenza presso MAR STUDIO."
>
  <section class="relative isolate flex min-h-[100svh] overflow-hidden bg-[#292F3F] text-white" data-luxury-hero>
    {heroVideo ? (
      <video
        class="absolute inset-0 h-full w-full object-cover"
        src={heroVideo}
        poster={heroPoster}
        autoplay
        loop
        muted
        playsinline
        aria-hidden="true"
      ></video>
    ) : (
      <img
        class="ken-burns absolute inset-0 h-full w-full object-cover"
        src={heroPoster}
        alt=""
        aria-hidden="true"
        fetchpriority="high"
      />
    )}
    <div
      class="absolute inset-0 bg-gradient-to-t from-[#292F3F]/85 via-[#49273C]/45 to-[#292F3F]/60"
      aria-hidden="true"
    ></div>
    <div class="relative z-10 mx-auto flex min-h-[100svh] w-full max-w-7xl items-end px-5 pb-24 pt-40 sm:px-8 md:pb-32">
      <div class="max-w-4xl">
        <p class="text-xs font-semibold uppercase tracking-[0.22em] text-[#B7C3DB]">
          {site.hero.eyebrow}
        </p>
        <h1 class="mt-6 max-w-4xl font-display text-6xl leading-[0.9] sm:text-7xl md:text-8xl">
          {heroTitleLead && <>{heroTitleLead} </>}
          <em class="font-normal">{heroTitleEmphasis}</em>
        </h1>
        {site.hero.description?.trim() && (
          <p class="mt-7 max-w-2xl text-base leading-8 text-white/80 sm:text-lg">
            {site.hero.description}
          </p>
        )}
        <div class="mt-9 flex flex-wrap gap-3">
          <a
            class="rounded-full bg-[#AF5A72] px-7 py-4 text-sm font-semibold text-white transition-colors duration-300 hover:bg-[#49273C]"
            href="/contatti"
          >
            {site.hero.primaryAction}
          </a>
          <a
            class="rounded-full border border-white/40 px-7 py-4 text-sm font-semibold text-white transition-colors duration-300 hover:bg-white/10"
            href="/trattamenti"
          >
            {site.hero.secondaryAction}
          </a>
        </div>
        <div class="mt-10 flex items-center gap-4 text-[0.65rem] font-medium uppercase tracking-[0.2em] text-white/65">
          <span>{site.contact.address.locality || "Imola"}</span>
          <span class="h-px w-8 bg-[#F9D6E3]/60" aria-hidden="true"></span>
          <span>Beauty · Dermopigmentazione · Academy</span>
        </div>
      </div>
    </div>
  </section>

  <AnimatedStats />

  <section class="mx-auto max-w-7xl px-5 py-24 sm:px-8 md:py-32" aria-labelledby="treatments-title">
    <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
      <div class="max-w-2xl">
        <p class="text-xs font-semibold uppercase tracking-[0.22em] text-[#AF5A72]">Trattamenti</p>
        <h2 id="treatments-title" class="mt-3 font-display text-4xl sm:text-5xl">
          Piccoli gesti, scelti per te.
        </h2>
      </div>
      <a class="text-sm font-semibold underline decoration-[#AF5A72] underline-offset-4" href="/trattamenti">
        Esplora tutti i trattamenti <span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="mt-9 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {treatments.map((service, index) => (
        <a
          class="group overflow-hidden rounded-3xl border border-[#292F3F]/10 bg-white/60 transition-transform hover:-translate-y-1"
          href={`/trattamenti/${service.slug}`}
        >
          <div
            class:list={[
              "relative flex aspect-[1.65] items-end p-5",
              index % 3 === 0
                ? "bg-[linear-gradient(145deg,#F8F3EF_0%,#EFE9E8_60%,#D9C3B9_100%)]"
                : index % 3 === 1
                  ? "bg-[linear-gradient(145deg,#F9F5F1_0%,#EFE9E8_100%)]"
                  : "bg-[linear-gradient(145deg,#F5E7E1_0%,#AF5A72_100%)]",
            ]}
            role="img"
            aria-label={service.imageAlt?.trim() || service.name}
          >
            {service.image ? (
              <img
                class="absolute inset-0 h-full w-full object-cover"
                src={service.image}
                alt={service.imageAlt?.trim() || service.name}
                loading="lazy"
              />
            ) : (
              <img
                class="pointer-events-none absolute right-4 top-4 h-10 w-auto opacity-50"
                src="/images/brand/monogramma.png"
                alt=""
                aria-hidden="true"
                loading="lazy"
              />
            )}
            <span class="rounded-full bg-[#FFFFFF]/85 px-4 py-2 text-xs text-[#49273C]">
              {service.placeholderLabel?.trim() || service.name}
            </span>
          </div>
          <div class="p-6">
            <h3 class="font-display text-2xl group-hover:text-[#AF5A72]">{service.name}</h3>
            {service.shortDescription?.trim() && (
              <p class="mt-2 text-sm leading-6 text-[#49273C]">{service.shortDescription}</p>
            )}
            <span class="mt-5 inline-block text-xs font-semibold uppercase tracking-wide text-[#AF5A72]">
              Scopri di più <span aria-hidden="true">→</span>
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="bg-[#EFE9E8] px-5 py-24 sm:px-8 md:py-32" aria-labelledby="about-title">
    <div class="mx-auto grid max-w-7xl gap-10 md:grid-cols-[0.8fr_1.2fr] md:items-center">
      <div
        class="relative flex min-h-[300px] items-end overflow-hidden rounded-t-full rounded-b-2xl bg-[radial-gradient(ellipse_at_60%_30%,#F9D6E3_0%,transparent_42%),linear-gradient(145deg,#F9F5F1,#EFE9E8)] p-7"
        role="img"
        aria-label="Spazio per un ritratto professionale di Marylin Casà"
      >
        {site.about.image && <img class="absolute inset-0 h-full w-full object-cover" src={site.about.image} alt="Ritratto professionale di Marylin Casà" loading="lazy" />}
        {!site.about.image && (
          <div class="relative mx-auto flex flex-col items-center text-center">
            <img class="w-28 opacity-70" src="/images/brand/monogramma.png" alt="" aria-hidden="true" loading="lazy" />
            <p class="mt-5 rounded-full border border-white/60 bg-white/75 px-4 py-2 text-xs text-[#49273C]">
              Ritratto di Marylin · in arrivo
            </p>
          </div>
        )}
      </div>
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.22em] text-[#AF5A72]">{site.about.eyebrow}</p>
        <h2 id="about-title" class="mt-3 font-display text-4xl sm:text-5xl">{site.about.title}</h2>
        {site.about.paragraphs?.[0]?.trim() && (
          <p class="mt-5 text-sm leading-7 text-[#49273C]">{site.about.paragraphs[0]}</p>
        )}
        {site.about.paragraphs?.[1]?.trim() && (
          <p class="mt-4 text-sm leading-7 text-[#49273C]">{site.about.paragraphs[1]}</p>
        )}
        <a class="mt-7 inline-flex text-sm font-semibold underline decoration-[#AF5A72] underline-offset-4" href="/chi-sono">
          Conosci Marylin <span class="ml-2" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 py-24 sm:px-8 md:py-32" aria-labelledby="results-title">
    <div class="grid gap-8 md:grid-cols-2 md:items-center">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.22em] text-[#AF5A72]">Risultati</p>
        <h2 id="results-title" class="mt-3 font-display text-4xl sm:text-5xl">La bellezza dei dettagli, nel tempo.</h2>
        <p class="mt-5 max-w-xl text-sm leading-7 text-[#49273C]">
          Una galleria di lavori reali sarà pubblicata con descrizioni accurate e il consenso delle persone ritratte.
        </p>
        <a class="mt-7 inline-flex text-sm font-semibold underline decoration-[#AF5A72] underline-offset-4" href="/prima-e-dopo">
          Vai alla galleria <span class="ml-2" aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div
          class="flex aspect-[0.85] items-end rounded-3xl bg-[linear-gradient(145deg,#F9F5F1,#EFE9E8)] p-4"
          role="img"
          aria-label={site.mediaPlaceholders[1].alt}
        >
          <span class="rounded-full bg-[#FFFFFF]/85 px-3 py-2 text-xs">Prima</span>
        </div>
        <div
          class="mt-8 flex aspect-[0.85] items-end rounded-3xl bg-[linear-gradient(145deg,#49273C,#AF5A72)] p-4"
          role="img"
          aria-label={site.mediaPlaceholders[1].alt}
        >
          <span class="rounded-full bg-[#FFFFFF]/85 px-3 py-2 text-xs">Dopo</span>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[#EFE9E8] px-5 py-24 sm:px-8 md:py-32" aria-labelledby="reviews-title">
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-xs font-semibold uppercase tracking-[0.22em] text-[#AF5A72]">Esperienze</p>
      <h2 id="reviews-title" class="mt-3 font-display text-4xl">Ogni percorso parte dall'ascolto.</h2>
      {reviews.length > 0 ? (
        <div class="mt-8 grid gap-4 text-left sm:grid-cols-2">
        {reviews.map((review) => (
            <figure class="rounded-2xl bg-[#FFFFFF] p-6">
              {review.rating != null && (
                <p class="text-sm tracking-widest text-[#AF5A72]" aria-label={`${review.rating} stelle su 5`}>
                  {"★".repeat(review.rating)}
                </p>
              )}
              {review.text?.trim() && (
                <blockquote class="text-sm leading-7 text-[#49273C]">“{review.text}”</blockquote>
              )}
              <figcaption class="mt-4 text-xs font-semibold">
                {review.name}
                {review.treatment?.trim() && (
                  <span class="font-normal text-[#49273C]"> · {review.treatment}</span>
                )}
              </figcaption>
            </figure>
          ))}
        </div>
      ) : (
        <p class="mt-5 text-sm leading-7 text-[#49273C]">
          Le recensioni autentiche saranno condivise qui con il consenso delle clienti.
        </p>
      )}
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 py-24 sm:px-8 md:py-32" aria-labelledby="location-title">
    <div class="grid gap-8 rounded-[2rem] border border-[#292F3F]/10 bg-white/60 p-7 sm:p-10 md:grid-cols-[1fr_1fr] md:items-center">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.22em] text-[#AF5A72]">Dove siamo</p>
        <h2 id="location-title" class="mt-3 font-display text-4xl">Ti aspettiamo in studio.</h2>
        {site.contact.address.street || site.contact.address.locality ? (
          <p class="mt-4 text-sm leading-7 text-[#49273C]">
            {[site.contact.address.street, site.contact.address.postalCode, site.contact.address.locality, site.contact.address.province]
              .filter(Boolean)
              .join(", ")}
          </p>
        ) : (
          <p class="mt-4 text-sm leading-7 text-[#49273C]">
            L'indirizzo e le indicazioni per raggiungere lo studio saranno aggiornati appena confermati.
          </p>
        )}
        <a
          class="mt-6 inline-flex rounded-full border border-[#292F3F]/20 px-5 py-3 text-sm font-semibold transition-colors hover:bg-[#EFE9E8]"
          href={site.social.mapsSearchUrl}
          target="_blank"
          rel="noreferrer"
        >
          Apri su Google Maps <span class="ml-2" aria-hidden="true">↗</span>
        </a>
      </div>
      <iframe
        class="h-64 w-full rounded-2xl border-0 bg-[#EFE9E8] sm:h-80"
        src={site.social.mapsEmbedUrl}
        title="Mappa per cercare MAR STUDIO by Marylin Casà"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>
  </section>

  <CtaConversionBlock
    title={site.conversion.title}
    description={site.conversion.description}
    buttonLabel={site.hero.primaryAction}
    message="Ciao Marylin, vorrei prenotare una consulenza presso MAR STUDIO."
  />
</BaseLayout>
