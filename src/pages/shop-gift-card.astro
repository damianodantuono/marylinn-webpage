---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getProducts, getStudio, getWhatsAppUrl } from "@/lib/content";

const site = await getStudio();
const products = await getProducts();
---

<BaseLayout
  title="Sieri e Gift Card"
  description="Scopri la vetrina MAR STUDIO di sieri, prodotti per la cura e Gift Card. Richieste e disponibilità vengono gestite direttamente su WhatsApp."
>
  <section class="mx-auto max-w-7xl px-5 py-24 sm:px-8 md:py-32">
    <p class="text-xs font-semibold uppercase tracking-[0.22em] text-[#AF5A72]">La vetrina MAR STUDIO</p>
    <h1 class="mt-3 font-display text-5xl sm:text-6xl">
      Piccole attenzioni, <em class="font-normal">da regalare o regalarti.</em>
    </h1>
    <p class="mt-5 max-w-2xl text-base leading-8 text-[#49273C]">
      Una selezione di prodotti per la cura e Gift Card da richiedere direttamente allo studio. Disponibilità, indicazioni e importi vengono confermati prima dell'acquisto.
    </p>
  </section>

  <section class="bg-[#EFE9E8] px-5 py-24 sm:px-8 md:py-32" aria-labelledby="products-title">
    <div class="mx-auto max-w-7xl">
      <p class="text-xs font-semibold uppercase tracking-[0.22em] text-[#AF5A72]">Cura quotidiana</p>
      <h2 id="products-title" class="mt-3 font-display text-4xl sm:text-5xl">Sieri e prodotti.</h2>
      {products.length > 0 ? (
        <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {products.map((product) => (
            <article class="overflow-hidden rounded-3xl border border-[#AF5A72]/25 bg-[#FFFFFF]">
              <div class="relative flex aspect-[1.1] items-end overflow-hidden bg-[linear-gradient(145deg,#F8F3EF_0%,#EFE9E8_100%)] p-5" role="img" aria-label={product.imageAlt?.trim() || product.name}>
                {product.image ? (
                  <img class="absolute inset-0 h-full w-full object-cover" src={product.image} alt={product.imageAlt?.trim() || product.name} loading="lazy" />
                ) : (
                  <span class="relative rounded-full bg-[#FFFFFF]/85 px-4 py-2 text-xs">Immagine prodotto in aggiornamento</span>
                )}
              </div>
              <div class="p-6">
                <h3 class="font-display text-2xl">{product.name}</h3>
                {product.description?.trim() && (
                  <p class="mt-3 text-sm leading-6 text-[#49273C]">{product.description}</p>
                )}
                {product.benefits?.some((benefit) => benefit.trim()) && (
                  <ul class="mt-3 space-y-1 text-xs text-[#49273C]">
                    {product.benefits.filter((benefit) => benefit.trim()).map((benefit) => <li>· {benefit}</li>)}
                  </ul>
                )}
                {product.indicativePrice?.trim() && (
                  <p class="mt-4 text-sm font-semibold">{product.indicativePrice}</p>
                )}
                <a class="mt-5 inline-flex rounded-full bg-[#292F3F] px-5 py-3 text-sm font-semibold text-white" href={getWhatsAppUrl(site, `Ciao Marylin, vorrei informazioni su ${product.name}.`) ?? "/contatti"}>
                  Richiedi su WhatsApp
                </a>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="mt-7 max-w-3xl rounded-3xl bg-[#FFFFFF] p-7 sm:p-9">
          <h3 class="font-display text-2xl">Selezione prodotti in aggiornamento.</h3>
          <p class="mt-3 text-sm leading-7 text-[#49273C]">
            I prodotti e le relative informazioni saranno pubblicati dopo la verifica della disponibilità e delle indicazioni d'uso.
          </p>
        </div>
      )}
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 py-24 sm:px-8 md:py-32" aria-labelledby="gift-cards-title">
    <div class="grid gap-8 overflow-hidden rounded-[2rem] bg-[#292F3F] text-[#FFFFFF] md:grid-cols-[1.1fr_0.9fr]">
      <div class="px-7 py-10 sm:px-12 sm:py-24">
        <p class="text-xs font-semibold uppercase tracking-[0.22em] text-[#F9D6E3]">Un pensiero speciale</p>
        <h2 id="gift-cards-title" class="mt-4 font-display text-4xl sm:text-5xl">Gift Card MAR STUDIO.</h2>
        <p class="mt-5 max-w-xl text-sm leading-7 text-white/70">
          Regala un momento di cura. Puoi chiedere informazioni sulle opzioni disponibili e concordare il trattamento o l'importo direttamente con lo studio.
        </p>
        {site.giftCards.note?.trim() && (
          <p class="mt-4 text-xs leading-6 text-white/55">{site.giftCards.note}</p>
        )}
        <a
          class="mt-7 inline-flex rounded-full bg-[#F9D6E3] px-6 py-4 text-sm font-semibold text-[#292F3F] transition-colors hover:bg-white"
          href={getWhatsAppUrl(site, "Ciao Marylin, vorrei informazioni sulle Gift Card MAR STUDIO.") ?? "/contatti"}
        >
          Regala / prenota una Gift Card
        </a>
      </div>
      <div class="flex items-center justify-center bg-[radial-gradient(ellipse_at_50%_30%,#AF5A72_0%,transparent_60%),linear-gradient(145deg,#49273C,#292F3F)] p-8">
        <div class="relative w-full max-w-sm rotate-[-2deg] overflow-hidden rounded-3xl border border-white/30 bg-white/10 p-7 backdrop-blur-sm">
          <img
            class="pointer-events-none absolute -right-3 -top-5 h-32 w-auto opacity-20"
            src="/images/brand/monogramma.png"
            alt=""
            aria-hidden="true"
            loading="lazy"
          />
          <p class="relative font-display text-2xl tracking-[0.12em]">{site.brand.name}</p>
          <p class="relative mt-2 text-xs tracking-[0.18em] text-[#F9D6E3]">GIFT CARD</p>
          <div class="mt-10 flex flex-wrap gap-2">
            {site.giftCards.amounts.map((amount) => (
              <span class="rounded-full border border-white/30 px-3 py-2 text-xs">{amount} €</span>
            ))}
            <span class="rounded-full border border-white/30 px-3 py-2 text-xs">Importo personalizzato</span>
          </div>
        </div>
      </div>
    </div>
    <p class="mt-4 text-center text-xs text-[#49273C]">
      Vetrina informativa: non sono previsti carrello o pagamenti online.
    </p>
  </section>
</BaseLayout>
